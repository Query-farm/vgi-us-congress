query TTI
SELECT bioguide_id, state_name, district FROM us_congress.main.congress_gov_members(congress := 118, state := 'CA') ORDER BY bioguide_id;
----
F000480	California	20
M001225	California	15

query TI
SELECT coalesce(bill_id, 'amendment'), amendment_number FROM us_congress.main.sponsored_legislation('S000148') ORDER BY 1;
----
amendment	1400
s2001-119	NULL
s600-118	NULL

query I
SELECT count(*) FROM us_congress.main.cosponsored_legislation('S000148');
----
2

