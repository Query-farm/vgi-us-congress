# ---------------------------------------------------------------- committees, nominations, treaties

query TTT
SELECT system_code, chamber, parent_system_code FROM us_congress.main.committees(congress := 118, chamber := 'senate') ORDER BY system_code;
----
ssfi00	senate	NULL
ssfi10	senate	ssfi00
ssju00	senate	NULL

query TTT
SELECT citation, is_civilian, is_military FROM us_congress.main.nominations(congress := 119) ORDER BY citation;
----
PN12-1	true	false
PN373	true	false
PN50	false	true

# WHERE congress = 119 is pushed into the request path too.
query I
SELECT count(*) FROM us_congress.main.nominations() WHERE congress = 119;
----
3

query IIT
SELECT congress_received, number, topic FROM us_congress.main.treaties(congress := 117) ORDER BY number;
----
117	1	Maritime Boundaries and Claims
117	3	International Law and Organization

# ---------------------------------------------------------------- House votes

query IITT
SELECT roll_call_number, legislation_number, result, amendment_type FROM us_congress.main.house_votes(118, session := 1) ORDER BY roll_call_number;
----
296	583	Passed	NULL
320	NULL	Failed	hamdt

query TTI
SELECT party, vote_cast, count(*) FROM us_congress.main.house_vote_positions(118, 1, 296) GROUP BY ALL ORDER BY ALL;
----
D	Nay	2
D	Not Voting	1
R	Aye	2

# Positions join the keyless members table on bioguide_id.
query T
SELECT m.full_name FROM us_congress.main.house_vote_positions(118, 1, 296) p
JOIN us_congress.main.members m USING (bioguide_id) WHERE p.vote_cast = 'Not Voting';
----
Alexandria Ocasio-Cortez

statement error
